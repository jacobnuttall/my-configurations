<Multi_key> <i> <F> : "𝐹" U1D439  # Math italic capital F
<Multi_key> <i> <G> : "𝐺" U1D43A  # Math italic capital G
<Multi_key> <i> <H> : "𝐻" U1D43B  # Math italic capital H
<Multi_key> <i> <I> : "𝐼" U1D43C  # Math italic capital I
<Multi_key> <i> <J> : "𝐽" U1D43D  # Math italic capital J
<Multi_key> <i> <K> : "𝐾" U1D43E  # Math italic capital K
<Multi_key> <i> <L> : "𝐿" U1D43F  # Math italic capital L

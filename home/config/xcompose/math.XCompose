# ======================================================================
# MATH ITALIC ALPHABET
# ======================================================================

# Compose + i + <letter>
# Mathematical italic (𝐴 → 𝑨 is bold, here we do italic)
# Special: h → ℎ (Planck constant)

# --- Math italic capitals (i + uppercase) ---
<Multi_key> <i> <A> : "𝐴" U1D434  # Math italic capital A
<Multi_key> <i> <B> : "𝐵" U1D435  # Math italic capital B
<Multi_key> <i> <C> : "𝐶" U1D436  # Math italic capital C

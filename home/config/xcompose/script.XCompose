# Compose + s + <letter>
# Mathematical script letters (𝒜, 𝒷, etc.)
# Some letters have special Unicode points (ℬ, ℰ, ℱ, etc.)

# --- Script capitals (s + uppercase) ---
<Multi_key> <s> <A> : "𝒜" U1D49C  # Script capital A
<Multi_key> <s> <B> : "ℬ" U212C  # Script capital B
<Multi_key> <s> <C> : "𝒞" U1D49E  # Script capital C
<Multi_key> <s> <D> : "𝒟" U1D49F  # Script capital D
<Multi_key> <s> <E> : "ℰ" U2130  # Script capital E
<Multi_key> <s> <F> : "ℱ" U2131  # Script capital F
<Multi_key> <s> <G> : "𝒢" U1D4A2  # Script capital G
<Multi_key> <s> <H> : "ℋ" U210B  # Script capital H
<Multi_key> <s> <I> : "ℐ" U2110  # Script capital I
<Multi_key> <s> <J> : "𝒥" U1D4A5  # Script capital J
<Multi_key> <s> <K> : "𝒦" U1D4A6  # Script capital K
<Multi_key> <s> <L> : "ℒ" U2112  # Script capital L
<Multi_key> <s> <M> : "ℳ" U2133  # Script capital M
<Multi_key> <s> <N> : "𝒩" U1D4A9  # Script capital N
<Multi_key> <s> <O> : "𝒪" U1D4AA  # Script capital O
<Multi_key> <s> <P> : "𝒫" U1D4AB  # Script capital P
<Multi_key> <s> <Q> : "𝒬" U1D4AC  # Script capital Q
<Multi_key> <s> <R> : "ℛ" U211B  # Script capital R
<Multi_key> <s> <S> : "𝒮" U1D4AE  # Script capital S
<Multi_key> <s> <T> : "𝒯" U1D4AF  # Script capital T
<Multi_key> <s> <U> : "𝒰" U1D4B0  # Script capital U
<Multi_key> <s> <V> : "𝒱" U1D4B1  # Script capital V
<Multi_key> <s> <W> : "𝒲" U1D4B2  # Script capital W
<Multi_key> <s> <X> : "𝒳" U1D4B3  # Script capital X
<Multi_key> <s> <Y> : "𝒴" U1D4B4  # Script capital Y
<Multi_key> <s> <Z> : "𝒵" U1D4B5  # Script capital Z

# --- Script lowercase (s + lowercase) ---
<Multi_key> <s> <a> : "𝒶" U1D4B6  # Script small a
<Multi_key> <s> <b> : "𝒷" U1D4B7  # Script small b
<Multi_key> <s> <c> : "𝒸" U1D4B8  # Script small c
<Multi_key> <s> <d> : "𝒹" U1D4B9  # Script small d
<Multi_key> <s> <e> : "ℯ" U212F  # Script small e
<Multi_key> <s> <f> : "𝒻" U1D4BB  # Script small f
<Multi_key> <s> <g> : "ℊ" U210A  # Script small g
<Multi_key> <s> <h> : "𝒽" U1D4BD  # Script small h
<Multi_key> <s> <i> : "𝒾" U1D4BE  # Script small i
<Multi_key> <s> <j> : "𝒿" U1D4BF  # Script small j
<Multi_key> <s> <k> : "𝓀" U1D4C0  # Script small k
<Multi_key> <s> <l> : "ℓ" U2113  # Script small l
<Multi_key> <s> <m> : "𝓂" U1D4C2  # Script small m
<Multi_key> <s> <n> : "𝓃" U1D4C3  # Script small n
<Multi_key> <s> <o> : "ℴ" U2134  # Script small o
<Multi_key> <s> <p> : "𝓅" U1D4C5  # Script small p
<Multi_key> <s> <q> : "𝓆" U1D4C6  # Script small q
<Multi_key> <s> <r> : "𝓇" U1D4C7  # Script small r
<Multi_key> <s> <s> : "𝓈" U1D4C8  # Script small s
<Multi_key> <s> <t> : "𝓉" U1D4C9  # Script small t
<Multi_key> <s> <u> : "𝓊" U1D4CA  # Script small u
<Multi_key> <s> <v> : "𝓋" U1D4CB  # Script small v
<Multi_key> <s> <w> : "𝓌" U1D4CC  # Script small w
<Multi_key> <s> <x> : "𝓍" U1D4CD  # Script small x

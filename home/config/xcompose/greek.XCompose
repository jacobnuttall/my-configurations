# --- Greek variants (Compose + g + <letter> + *) ---
# Variant / alternative forms of Greek letters
<Multi_key> <g> <e> <asterisk> : "ϵ" U03F5  # Greek variant lunate epsilon
<Multi_key> <g> <u> <asterisk> : "ϑ" U03D1  # Greek variant script theta
<Multi_key> <g> <k> <asterisk> : "ϰ" U03F0  # Greek variant kappa symbol
<Multi_key> <g> <p> <asterisk> : "ϖ" U03D6  # Greek variant pi symbol (variant)
<Multi_key> <g> <r> <asterisk> : "ϱ" U03F1  # Greek variant rho symbol (variant ϱ)
<Multi_key> <g> <f> <asterisk> : "φ" U03C6  # Greek variant phi (curly φ)

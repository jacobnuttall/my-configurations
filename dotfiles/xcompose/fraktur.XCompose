<Multi_key> <Multi_key> <f> <R> : "ℜ" U211C  # Fraktur capital R
<Multi_key> <Multi_key> <f> <S> : "𝔖" U1D516  # Fraktur capital S
<Multi_key> <Multi_key> <f> <T> : "𝔗" U1D517  # Fraktur capital T
<Multi_key> <Multi_key> <f> <U> : "𝔘" U1D518  # Fraktur capital U

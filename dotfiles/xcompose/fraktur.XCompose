
# ======================================================================
# FRAKTUR ALPHABET
# ======================================================================

# Compose + f + <letter>
# Mathematical fraktur letters (𝔞, 𝔄, etc.)
# Some capitals have dedicated code points (ℌ, ℑ, ℜ, ℨ)

# --- Fraktur capitals (f + uppercase) ---
<Multi_key> <Multi_key> <f> <A> : "𝔄" U1D504  # Fraktur capital A
<Multi_key> <Multi_key> <f> <B> : "𝔅" U1D505  # Fraktur capital B
<Multi_key> <Multi_key> <f> <C> : "ℭ" U212D  # Fraktur capital C
<Multi_key> <Multi_key> <f> <D> : "𝔇" U1D507  # Fraktur capital D
<Multi_key> <Multi_key> <f> <E> : "𝔈" U1D508  # Fraktur capital E
<Multi_key> <Multi_key> <f> <F> : "𝔉" U1D509  # Fraktur capital F
<Multi_key> <Multi_key> <f> <G> : "𝔊" U1D50A  # Fraktur capital G
<Multi_key> <Multi_key> <f> <H> : "ℌ" U210C  # Fraktur capital H
<Multi_key> <Multi_key> <f> <I> : "ℑ" U2111  # Fraktur capital I
<Multi_key> <Multi_key> <f> <J> : "𝔍" U1D50D  # Fraktur capital J

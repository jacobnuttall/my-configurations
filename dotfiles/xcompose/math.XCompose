# --- Floor / ceiling (from KLC square-image dead key) ---
<Multi_key> <Multi_key> <bracketleft> <slash> <bracketright> : "⟦" U27E6  # White left square bracket ⟦ (alternate)
<Multi_key> <Multi_key> <bracketleft> <backslash> <bracketright> : "⟧" U27E7  # White right square bracket ⟧ (alternate)

# --- Less/greater variants ---
<Multi_key> <Multi_key> <less> <backslash> <greater> : "⟨" U27E8  # Left angle bracket ⟨ (alternate)
<Multi_key> <Multi_key> <greater> <backslash> <less> : "⟩" U27E9  # Right angle bracket ⟩ (alternate)
<Multi_key> <Multi_key> <less> <greater> <equal> : "⋈" U22C8  # Bowtie ⋈ (alternate)
<Multi_key> <Multi_key> <less> <a> : "∠" U2220  # Angle ∠ (alternate)
<Multi_key> <Multi_key> <less> <bar> <exclam> : "∟" U221F  # Right angle ∟

# --- Blackboard bold specials from original KLC ---

# --- Additional sum/product-like big operators ---
<Multi_key> <Multi_key> <slash> <i> <plus> : "⨌" U2A0C  # Quadruple integral ⨌

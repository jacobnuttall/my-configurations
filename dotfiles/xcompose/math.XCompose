# .XCompose — Mathematical Keyboard for Unicode Typesetting
# (c) 2026 Jacob Nuttall — rewritten for Linux Compose key
#
# Prefix conventions:
#   g <letter>       → Greek letter  (g a = α, g A = Α)
#   g <letter> *     → Greek variant  (g e * = ϵ→ε variant, g r * = ϱ)
#   s <letter>       → Script / calligraphic  (s a = 𝒶, s A = 𝒜)
#   f <letter>       → Fraktur  (f a = 𝔞, f A = 𝔄)
#   d <letter>       → Double-struck / blackboard bold  (d A = 𝔸)
#   ^ <key>          → Superscript  (^ 2 = ²)
#   _ <key>          → Subscript  (_ 2 = ₂)
#   - >              → Arrow  (- > = →)
#   Shape-based keys where possible (e.g. [ ] = □)
#
# To use: copy to ~/.XCompose and set GTK_IM_MODULE=xim or use ibus/fcitx.
# Include the default compose table:
include "%L"
# Compose + ^ + <key>
# ======================================================================
# FRACTIONS
# ======================================================================

# Compose + numerator + / + denominator
<Multi_key> <Multi_key> <1> <slash> <2> : "½" U00BD  # Vulgar fraction 1/2
<Multi_key> <Multi_key> <1> <slash> <3> : "⅓" U2153  # Vulgar fraction 1/3
<Multi_key> <Multi_key> <2> <slash> <3> : "⅔" U2154  # Vulgar fraction 2/3
<Multi_key> <Multi_key> <1> <slash> <4> : "¼" U00BC  # Vulgar fraction 1/4
<Multi_key> <Multi_key> <3> <slash> <4> : "¾" U00BE  # Vulgar fraction 3/4
<Multi_key> <Multi_key> <1> <slash> <5> : "⅕" U2155  # Vulgar fraction 1/5
<Multi_key> <Multi_key> <2> <slash> <5> : "⅖" U2156  # Vulgar fraction 2/5
<Multi_key> <Multi_key> <3> <slash> <5> : "⅗" U2157  # Vulgar fraction 3/5
<Multi_key> <Multi_key> <4> <slash> <5> : "⅘" U2158  # Vulgar fraction 4/5
<Multi_key> <Multi_key> <1> <slash> <6> : "⅙" U2159  # Vulgar fraction 1/6
<Multi_key> <Multi_key> <5> <slash> <6> : "⅚" U215A  # Vulgar fraction 5/6
<Multi_key> <Multi_key> <1> <slash> <7> : "⅐" U2150  # Vulgar fraction 1/7
<Multi_key> <Multi_key> <1> <slash> <8> : "⅛" U215B  # Vulgar fraction 1/8
<Multi_key> <Multi_key> <3> <slash> <8> : "⅜" U215C  # Vulgar fraction 3/8
<Multi_key> <Multi_key> <5> <slash> <8> : "⅝" U215D  # Vulgar fraction 5/8
<Multi_key> <Multi_key> <7> <slash> <8> : "⅞" U215E  # Vulgar fraction 7/8
<Multi_key> <Multi_key> <1> <slash> <9> : "⅑" U2151  # Vulgar fraction 1/9
<Multi_key> <Multi_key> <1> <slash> <0> : "⅒" U2152  # Vulgar fraction 1/10
<Multi_key> <Multi_key> <0> <slash> <3> : "↉" U2189  # Vulgar fraction 0/3
<Multi_key> <Multi_key> <slash> <1> : "⅟" U215F  # Fraction numerator one (⅟)

# ======================================================================
# ROOTS
# ======================================================================

# Compose + root-like sequences
<Multi_key> <Multi_key> <slash> <slash> <2> : "√" U221A  # Square root √
<Multi_key> <Multi_key> <slash> <slash> <3> : "∛" U221B  # Cube root ∛
<Multi_key> <Multi_key> <slash> <slash> <4> : "∜" U221C  # Fourth root ∜

# ======================================================================
# LOGIC & QUANTIFIERS
# ======================================================================


# --- Quantifiers and basic logic ---
<Multi_key> <Multi_key> <A> <period> : "∀" U2200  # For all ∀
<Multi_key> <Multi_key> <E> <period> : "∃" U2203  # There exists ∃
<Multi_key> <Multi_key> <E> <exclam> : "∃" U2203  # There exists (alternate)
<Multi_key> <Multi_key> <slash> <E> <period> : "∄" U2204  # There does not exist ∄
<Multi_key> <Multi_key> <exclam> <E> <period> : "∄" U2204  # There does not exist (alternate) ∄
<Multi_key> <Multi_key> <ampersand> <ampersand> : "∧" U2227  # Logical and ∧
<Multi_key> <Multi_key> <bar> <bar> : "∨" U2228  # Logical or ∨
<Multi_key> <Multi_key> <exclam> <exclam> : "¬" U00AC  # Not sign ¬
<Multi_key> <Multi_key> <exclam> <p> : "¬" U00AC  # Not sign (alternate) ¬
<Multi_key> <Multi_key> <minus> <bar> : "⊢" U22A2  # Right tack ⊢ (proves/turnstile)
<Multi_key> <Multi_key> <bar> <minus> : "⊣" U22A3  # Left tack ⊣
<Multi_key> <Multi_key> <bar> <equal> : "⊨" U22A8  # Models ⊨ (double turnstile)
<Multi_key> <Multi_key> <minus> <bar> <equal> : "⊩" U22A9  # Forces ⊩
<Multi_key> <Multi_key> <bar> <minus> <bar> : "⊦" U22A6  # Assertion ⊦
<Multi_key> <Multi_key> <T> <period> : "⊤" U22A4  # Down tack ⊤ (top/true)
<Multi_key> <Multi_key> <underscore> <bar> <underscore> : "⊥" U22A5  # Up tack ⊥ (bottom/false)

# --- N-ary logic ---
<Multi_key> <Multi_key> <ampersand> <ampersand> <ampersand> : "⋀" U22C0  # N-ary logical and ⋀ (big wedge)
<Multi_key> <Multi_key> <bar> <bar> <bar> : "⋁" U22C1  # N-ary logical or ⋁ (big vee)

# ======================================================================
# SET THEORY
# ======================================================================


# --- Membership ---
<Multi_key> <Multi_key> <e> <period> : "∈" U2208  # Element of ∈
<Multi_key> <Multi_key> <exclam> <e> <period> : "∉" U2209  # Not element of ∉
<Multi_key> <Multi_key> <E> <e> <period> : "∋" U220B  # Contains as member ∋
<Multi_key> <Multi_key> <exclam> <E> <e> : "∌" U220C  # Does not contain ∌

# --- Set operations ---
<Multi_key> <Multi_key> <U> <period> : "∪" U222A  # Union ∪
<Multi_key> <Multi_key> <U> <U> : "⋃" U22C3  # N-ary union ⋃
<Multi_key> <Multi_key> <n> <period> : "∩" U2229  # Intersection ∩
<Multi_key> <Multi_key> <n> <period> <n> <period> : "⋂" U22C2  # N-ary intersection ⋂
<Multi_key> <Multi_key> <backslash> <backslash> : "∖" U2216  # Set minus ∖
<Multi_key> <Multi_key> <0> <slash> : "∅" U2205  # Empty set ∅

# --- Subset / superset ---
<Multi_key> <Multi_key> <parenleft> <less> : "⊂" U2282  # Subset of ⊂
<Multi_key> <Multi_key> <parenleft> <less> <equal> : "⊆" U2286  # Subset of or equal ⊆
<Multi_key> <Multi_key> <parenleft> <less> <exclam> : "⊈" U2288  # Not subset of or equal ⊄
<Multi_key> <Multi_key> <parenleft> <less> <slash> : "⊄" U2284  # Not a subset of ⊄
<Multi_key> <Multi_key> <greater> <parenright> : "⊃" U2283  # Superset of ⊃
<Multi_key> <Multi_key> <greater> <parenright> <equal> : "⊇" U2287  # Superset of or equal ⊇
<Multi_key> <Multi_key> <greater> <parenright> <exclam> : "⊉" U2289  # Not superset of or equal
<Multi_key> <Multi_key> <greater> <parenright> <slash> : "⊅" U2285  # Not a superset of ⊅
<Multi_key> <Multi_key> <parenleft> <less> <less> : "⋐" U22D0  # Double subset ⋐
<Multi_key> <Multi_key> <greater> <parenright> <greater> : "⋑" U22D1  # Double superset ⋑

# ======================================================================
# RELATIONS & ORDERING
# ======================================================================


# --- Equality and similarity ---
<Multi_key> <Multi_key> <equal> <equal> : "≡" U2261  # Identical to ≡ (triple bar)
<Multi_key> <Multi_key> <exclam> <equal> : "≠" U2260  # Not equal to ≠
<Multi_key> <Multi_key> <asciitilde> <equal> : "≅" U2245  # Approximately equal to ≅ (congruent)
<Multi_key> <Multi_key> <asciitilde> <asciitilde> : "≈" U2248  # Almost equal to ≈
<Multi_key> <Multi_key> <asciitilde> <minus> : "≃" U2243  # Asymptotically equal ≃ (simeq)
<Multi_key> <Multi_key> <period> <equal> : "≐" U2250  # Approaches the limit ≐
<Multi_key> <Multi_key> <colon> <equal> : "≔" U2254  # Colon equals ≔ (definition)
<Multi_key> <Multi_key> <equal> <colon> : "≕" U2255  # Equals colon ≕
<Multi_key> <Multi_key> <equal> <question> : "≟" U225F  # Questioned equal ≟
<Multi_key> <Multi_key> <equal> <asciicircum> <equal> : "≙" U2259  # Estimates ≙ (hat equal)
<Multi_key> <Multi_key> <equal> <d> : "≝" U225D  # Equal by definition ≝
<Multi_key> <Multi_key> <equal> <m> : "≞" U225E  # Measured by ≞
<Multi_key> <Multi_key> <equal> <period> : "≐" U2250  # Approaches limit ≐
<Multi_key> <Multi_key> <asciitilde> <exclam> : "≄" U2244  # Not asymptotically equal ≄
<Multi_key> <Multi_key> <asciitilde> <slash> <equal> : "≇" U2247  # Not approximately equal ≇
<Multi_key> <Multi_key> <exclam> <asciitilde> <asciitilde> : "≉" U2249  # Not almost equal ≉
<Multi_key> <Multi_key> <exclam> <equal> <equal> : "≢" U2262  # Not identical to ≢
<Multi_key> <Multi_key> <equal> <slash> : "≄" U2244  # Not equal (slash, alternate)

# --- Ordering ---
<Multi_key> <Multi_key> <less> <equal> : "≤" U2264  # Less than or equal ≤
<Multi_key> <Multi_key> <greater> <equal> : "≥" U2265  # Greater than or equal ≥
<Multi_key> <Multi_key> <less> <less> : "≪" U226A  # Much less than ≪
<Multi_key> <Multi_key> <greater> <greater> : "≫" U226B  # Much greater than ≫
<Multi_key> <Multi_key> <less> <exclam> : "≮" U226E  # Not less than ≮
<Multi_key> <Multi_key> <greater> <exclam> : "≯" U226F  # Not greater than ≯
<Multi_key> <Multi_key> <less> <slash> <equal> : "≰" U2270  # Not less than or equal ≰
<Multi_key> <Multi_key> <greater> <slash> <equal> : "≱" U2271  # Not greater than or equal ≱
<Multi_key> <Multi_key> <less> <asciitilde> : "≲" U2272  # Less than or equivalent ≲
<Multi_key> <Multi_key> <greater> <asciitilde> : "≳" U2273  # Greater than or equivalent ≳
<Multi_key> <Multi_key> <less> <greater> <less> : "⋄" U22C4  # Diamond operator ⋄

# --- Precedes / succeeds ---
<Multi_key> <Multi_key> <less> <period> : "≺" U227A  # Precedes ≺
<Multi_key> <Multi_key> <greater> <period> : "≻" U227B  # Succeeds ≻
<Multi_key> <Multi_key> <less> <period> <equal> : "≼" U227C  # Precedes or equal ≼
<Multi_key> <Multi_key> <greater> <period> <equal> : "≽" U227D  # Succeeds or equal ≽
<Multi_key> <Multi_key> <less> <period> <asciitilde> : "≾" U227E  # Precedes or equivalent ≾
<Multi_key> <Multi_key> <greater> <period> <asciitilde> : "≿" U227F  # Succeeds or equivalent ≿
<Multi_key> <Multi_key> <less> <period> <exclam> : "⋠" U22E0  # Does not precede or equal ⋠
<Multi_key> <Multi_key> <greater> <period> <exclam> : "⋡" U22E1  # Does not succeed or equal ⋡

# ======================================================================
# OPERATORS
# ======================================================================


# --- Basic operators ---
<Multi_key> <Multi_key> <x> <x> : "×" U00D7  # Multiplication sign ×
<Multi_key> <Multi_key> <period> <period> : "⋅" U22C5  # Dot operator ⋅
<Multi_key> <Multi_key> <asterisk> <period> : "∙" U2219  # Bullet operator ∙
<Multi_key> <Multi_key> <asterisk> <asterisk> : "⋆" U22C6  # Star operator ⋆
<Multi_key> <Multi_key> <o> <period> : "∘" U2218  # Ring operator ∘ (composition)
<Multi_key> <Multi_key> <o> <x> : "⊗" U2297  # Circled times ⊗
<Multi_key> <Multi_key> <o> <plus> : "⊕" U2295  # Circled plus ⊕
<Multi_key> <Multi_key> <o> <minus> : "⊖" U2296  # Circled minus ⊖
<Multi_key> <Multi_key> <o> <slash> : "⊘" U2298  # Circled division ⊘
<Multi_key> <Multi_key> <o> <period> <period> : "⊙" U2299  # Circled dot ⊙
<Multi_key> <Multi_key> <o> <o> : "○" U25CB  # White circle ○
<Multi_key> <Multi_key> <plus> <minus> : "±" U00B1  # Plus-minus ±
<Multi_key> <Multi_key> <minus> <plus> : "∓" U2213  # Minus-or-plus ∓
<Multi_key> <Multi_key> <minus> <period> : "∸" U2238  # Dot minus ∸
<Multi_key> <Multi_key> <minus> <minus> : "−" U2212  # Minus sign −
<Multi_key> <Multi_key> <slash> <slash> : "∕" U2215  # Division slash ∕
<Multi_key> <Multi_key> <slash> <d> : "÷" U00F7  # Division sign ÷
<Multi_key> <Multi_key> <minus> <minus> <period> : "∸" U2238  # Dot minus (alternate) ∸

# --- N-ary / big operators ---
<Multi_key> <Multi_key> <S> <S> : "∑" U2211  # N-ary summation ∑
<Multi_key> <Multi_key> <P> <P> : "∏" U220F  # N-ary product ∏
<Multi_key> <Multi_key> <P> <C> : "∐" U2210  # N-ary coproduct ∐

# --- Integrals ---
<Multi_key> <Multi_key> <slash> <i> : "∫" U222B  # Integral ∫
<Multi_key> <Multi_key> <slash> <i> <i> : "∬" U222C  # Double integral ∬
<Multi_key> <Multi_key> <slash> <i> <i> <i> : "∭" U222D  # Triple integral ∭
<Multi_key> <Multi_key> <slash> <i> <o> : "∮" U222E  # Contour integral ∮
<Multi_key> <Multi_key> <slash> <i> <i> <o> : "∯" U222F  # Surface integral ∯
<Multi_key> <Multi_key> <slash> <i> <i> <i> <o> : "∰" U2230  # Volume integral ∰

# ======================================================================
# CALCULUS & ANALYSIS
# ======================================================================

<Multi_key> <Multi_key> <d> <period> : "∂" U2202  # Partial differential ∂
<Multi_key> <Multi_key> <D> <period> : "∇" U2207  # Nabla ∇ (del/gradient)
<Multi_key> <Multi_key> <o> <0> : "∞" U221E  # Infinity ∞
<Multi_key> <Multi_key> <slash> <0> : "∅" U2205  # Empty set ∅ (alternate)
<Multi_key> <Multi_key> <h> <minus> : "ħ" U0127  # Latin h with stroke ħ

# ======================================================================
# TILDE OPERATOR VARIANTS
# ======================================================================

# Compose + ~ + modifier
<Multi_key> <Multi_key> <asciitilde> <period> : "∼" U223C  # Tilde operator ∼
<Multi_key> <Multi_key> <asciitilde> <slash> <period> : "≁" U2241  # Not tilde ≁
<Multi_key> <Multi_key> <asciitilde> <bar> : "≀" U2240  # Wreath product ≀

# ======================================================================
# GEOMETRIC & SHAPE SYMBOLS
# ======================================================================

# Shape-based compose sequences
<Multi_key> <Multi_key> <bracketleft> <bracketright> : "□" U25A1  # White square □
<Multi_key> <Multi_key> <bracketleft> <bracketright> <period> : "■" U25A0  # Black square ■
<Multi_key> <Multi_key> <bracketleft> <bracketright> <plus> : "⊞" U229E  # Squared plus ⊞
<Multi_key> <Multi_key> <bracketleft> <bracketright> <minus> : "⊟" U229F  # Squared minus ⊟
<Multi_key> <Multi_key> <bracketleft> <bracketright> <x> : "⊠" U22A0  # Squared times ⊠
<Multi_key> <Multi_key> <bracketleft> <bracketright> <period> <period> : "⊡" U22A1  # Squared dot ⊡
<Multi_key> <Multi_key> <less> <greater> : "⋄" U22C4  # Diamond operator ⋄
<Multi_key> <Multi_key> <less> <greater> <period> : "◆" U25C6  # Black diamond ◆
<Multi_key> <Multi_key> <parenleft> <parenright> : "○" U25CB  # White circle ○ (alternate)
<Multi_key> <Multi_key> <parenleft> <parenright> <period> : "●" U25CF  # Black circle ●
<Multi_key> <Multi_key> <slash> <backslash> : "△" U25B3  # White up triangle △
<Multi_key> <Multi_key> <backslash> <slash> : "▽" U25BD  # White down triangle ▽
<Multi_key> <Multi_key> <slash> <backslash> <period> : "▲" U25B2  # Black up triangle ▲
<Multi_key> <Multi_key> <backslash> <slash> <period> : "▼" U25BC  # Black down triangle ▼

# ======================================================================
# BRACKETS & DELIMITERS
# ======================================================================

<Multi_key> <Multi_key> <less> <bar> : "⟨" U27E8  # Mathematical left angle bracket ⟨
<Multi_key> <Multi_key> <bar> <greater> : "⟩" U27E9  # Mathematical right angle bracket ⟩
<Multi_key> <Multi_key> <less> <bar> <bar> : "⟪" U27EA  # Mathematical left double angle ⟪
<Multi_key> <Multi_key> <bar> <bar> <greater> : "⟫" U27EB  # Mathematical right double angle ⟫
<Multi_key> <Multi_key> <bracketleft> <bar> : "⟦" U27E6  # Mathematical left white square bracket ⟦
<Multi_key> <Multi_key> <bar> <bracketright> : "⟧" U27E7  # Mathematical right white square bracket ⟧
<Multi_key> <Multi_key> <bar> <equal> <bar> <period> : "‖" U2016  # Double vertical line ‖
<Multi_key> <Multi_key> <braceleft> <bar> : "⌈" U2308  # Left ceiling ⌈
<Multi_key> <Multi_key> <bar> <braceright> : "⌉" U2309  # Right ceiling ⌉
<Multi_key> <Multi_key> <braceleft> <underscore> : "⌊" U230A  # Left floor ⌊
<Multi_key> <Multi_key> <underscore> <braceright> : "⌋" U230B  # Right floor ⌋
<Multi_key> <Multi_key> <bracketleft> <asciicircum> : "⌈" U2308  # Left ceiling (alternate) ⌈
<Multi_key> <Multi_key> <asciicircum> <bracketright> : "⌉" U2309  # Right ceiling (alternate) ⌉
<Multi_key> <Multi_key> <bracketleft> <underscore> : "⌊" U230A  # Left floor (alternate) ⌊
<Multi_key> <Multi_key> <underscore> <bracketright> : "⌋" U230B  # Right floor (alternate) ⌋

# ======================================================================
# DOTS & ELLIPSIS
# ======================================================================

<Multi_key> <Multi_key> <period> <period> <period> : "…" U2026  # Horizontal ellipsis …
<Multi_key> <Multi_key> <period> <asciicircum> : "⋮" U22EE  # Vertical ellipsis ⋮
<Multi_key> <Multi_key> <period> <slash> <period> : "⋰" U22F0  # Up right diagonal ellipsis ⋰
<Multi_key> <Multi_key> <period> <backslash> <period> : "⋱" U22F1  # Down right diagonal ellipsis ⋱
<Multi_key> <Multi_key> <colon> <colon> : "∷" U2237  # Proportion ∷
<Multi_key> <Multi_key> <semicolon> <semicolon> : "∶" U2236  # Ratio ∶

# ======================================================================
# COMBINING MARKS (for math accents)
# ======================================================================

# Type after the base character to add the accent
# These are standalone compose sequences that output the combining character
<Multi_key> <Multi_key> <grave> <grave> : "̀" U0300  # Combining grave accent
<Multi_key> <Multi_key> <apostrophe> <apostrophe> <apostrophe> : "́" U0301  # Combining acute accent
<Multi_key> <Multi_key> <asciicircum> <asciicircum> : "̂" U0302  # Combining circumflex (hat)
<Multi_key> <Multi_key> <asciitilde> <asciitilde> <asciitilde> : "̃" U0303  # Combining tilde
<Multi_key> <Multi_key> <minus> <equal> <minus> : "̄" U0304  # Combining macron (bar)
<Multi_key> <Multi_key> <period> <asciicircum> <period> : "̇" U0307  # Combining dot above
<Multi_key> <Multi_key> <period> <period> <asciicircum> : "̈" U0308  # Combining diaeresis (two dots above)
<Multi_key> <Multi_key> <o> <asciicircum> : "̊" U030A  # Combining ring above
<Multi_key> <Multi_key> <v> <asciicircum> : "̌" U030C  # Combining caron (háček)
<Multi_key> <Multi_key> <asciitilde> <underscore> <asciitilde> : "̰" U0330  # Combining tilde below
<Multi_key> <Multi_key> <minus> <underscore> <minus> : "̲" U0332  # Combining low line (underline)
<Multi_key> <Multi_key> <minus> <greater> <asciicircum> : "⃗" U20D7  # Combining right arrow above (vector)

# ======================================================================
# MISCELLANEOUS MATH SYMBOLS
# ======================================================================


# --- Miscellaneous operators ---
<Multi_key> <Multi_key> <colon> <colon> <equal> : "⩴" U2A74  # Colon colon equals ⩴
<Multi_key> <Multi_key> <period> <asterisk> : "∗" U2217  # Asterisk operator ∗
<Multi_key> <Multi_key> <numbersign> <numbersign> : "⋕" U22D5  # Equal and parallel ⋕
<Multi_key> <Multi_key> <bar> <equal> <bar> : "∥" U2225  # Parallel to ∥
<Multi_key> <Multi_key> <slash> <bar> <equal> : "∦" U2226  # Not parallel ∦
<Multi_key> <Multi_key> <underscore> <bar> : "⊥" U22A5  # Perpendicular ⊥ (alternate)
<Multi_key> <Multi_key> <slash> <period> <backslash> : "∠" U2220  # Angle ∠
<Multi_key> <Multi_key> <slash> <period> <equal> : "∡" U2221  # Measured angle ∡
<Multi_key> <Multi_key> <8> <8> : "∞" U221E  # Infinity ∞ (alternate mnemonic)
<Multi_key> <Multi_key> <numbersign> <period> : "ℵ" U2135  # Alef symbol ℵ
<Multi_key> <Multi_key> <numbersign> <1> : "ℶ" U2136  # Bet symbol ℶ
<Multi_key> <Multi_key> <numbersign> <2> : "ℷ" U2137  # Gimel symbol ℷ
<Multi_key> <Multi_key> <numbersign> <3> : "ℸ" U2138  # Dalet symbol ℸ
<Multi_key> <Multi_key> <W> <period> : "℘" U2118  # Weierstrass p ℘

# --- Squares and image-of ---
<Multi_key> <Multi_key> <bracketleft> <bracketleft> : "⊏" U228F  # Square image of ⊏
<Multi_key> <Multi_key> <bracketright> <bracketright> : "⊐" U2290  # Square original of ⊐
<Multi_key> <Multi_key> <bracketleft> <bracketleft> <equal> : "⊑" U2291  # Square image of or equal ⊑
<Multi_key> <Multi_key> <bracketright> <bracketright> <equal> : "⊒" U2292  # Square original of or equal ⊒
<Multi_key> <Multi_key> <bracketleft> <bracketleft> <exclam> : "⋢" U22E2  # Not square image of or equal ⋢

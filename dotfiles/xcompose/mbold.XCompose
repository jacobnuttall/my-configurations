# ======================================================================
# MATH BOLD ALPHABET
# ======================================================================

# Compose + B + <letter>
# Mathematical bold (𝐀, 𝐚, etc.)

# --- Math bold capitals (B + uppercase) ---
<Multi_key> <Multi_key> <B> <A> : "𝐀" U1D400  # Math bold capital A
